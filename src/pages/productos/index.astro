---
import Base from "../../layouts/Base.astro";
import CatalogListing from "../../components/CatalogListing.astro";
import { loadCatalog, readCatalogParams } from "../../components/catalog";

const state = readCatalogParams(Astro.url);
const data = await loadCatalog(state);
if (data.failed) Astro.response.status = 503;

// /productos?categoria=x es un alias de /categoria/x: el canonical apunta ahí.
const validCategory = data.categories.some((c) => c.slug === state.categoria);
const canonical = validCategory ? `/categoria/${state.categoria}` : "/productos";
---

<Base
  title="Catálogo"
  description="Velas artesanales, productos de belleza natural, insumos para velas y moldes impresos en 3D."
  canonical={canonical}
>
  <CatalogListing
    state={state}
    data={data}
    title="Catálogo"
    lead="Velas, productos de belleza, insumos y moldes para crear las tuyas."
  />
</Base>
