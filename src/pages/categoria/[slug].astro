---
import Base from "../../layouts/Base.astro";
import CatalogListing from "../../components/CatalogListing.astro";
import NotFound from "../../components/NotFound.astro";
import { loadCatalog, readCatalogParams } from "../../components/catalog";
import { getCategoryIntro } from "../../data/category-intros";

const slug = Astro.params.slug ?? "";
const state = readCatalogParams(Astro.url, slug);
const data = await loadCatalog(state);
const category = data.categories.find((c) => c.slug === slug);

// Si la base de datos falla no sabemos si la categoría existe: 503.
if (data.failed) Astro.response.status = 503;
else if (!category) Astro.response.status = 404;

const intro = category ? getCategoryIntro(category.slug, category.name) : null;
---

{
  data.failed ? (
    <Base title="Catálogo no disponible" description="No pudimos cargar el catálogo." noindex>
      <CatalogListing state={state} data={data} title="Catálogo" lead="" />
    </Base>
  ) : !category || !intro ? (
    <Base title="Página no encontrada" description="La página que buscas no existe." noindex>
      <NotFound />
    </Base>
  ) : (
    <Base title={category.name} description={intro.description} canonical={`/categoria/${category.slug}`}>
      <CatalogListing state={state} data={data} title={category.name} lead={intro.intro} categoryName={category.name} />
    </Base>
  )
}
