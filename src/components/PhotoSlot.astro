---
/**
 * Espacio para una foto. Sin `src` muestra el marcador de posición salvia
 * (oculto a lectores de pantalla). Cuando haya foto real, basta con pasar
 * `src`: el `alt`, `width` y `height` ya están definidos donde se usa.
 */
interface Props {
  src?: string | null;
  /** Texto alternativo. Vacío ("") si la foto es decorativa. */
  alt: string;
  width: number;
  height: number;
  /** Proporción del recuadro. */
  ratio?: "4/5" | "3/2";
  /** true para la imagen principal de la vista (carga prioritaria). */
  priority?: boolean;
  class?: string;
}

const { src, alt, width, height, ratio = "4/5", priority = false, class: className } = Astro.props;
---

<div class:list={["photo-slot", ratio === "3/2" ? "photo-slot--wide" : "photo-slot--portrait", className]}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <div class="photo-slot__placeholder" aria-hidden="true" />
    )
  }
  <slot />
</div>

<style>
  .photo-slot {
    position: relative;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--color-surface-tint);
  }
  .photo-slot--portrait {
    aspect-ratio: 4 / 5;
  }
  .photo-slot--wide {
    aspect-ratio: 3 / 2;
  }
  .photo-slot img,
  .photo-slot__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
