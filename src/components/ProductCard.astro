---
import type { CatalogProduct } from "../lib/products";
import { formatPrice } from "./formatPrice";

interface Props {
  product: CatalogProduct;
  /** Nombre visible de la categoría ("Moldes 3D"). */
  categoryName?: string;
  /** Nivel del título del producto. Por defecto 2. */
  headingLevel?: 2 | 3;
}

const { product, categoryName, headingLevel = 2 } = Astro.props;
// h2 bajo el h1 del catálogo; h3 cuando la tarjeta va dentro de una sección con h2 (inicio).
const Heading = headingLevel === 3 ? "h3" : "h2";

const onSale = product.compare_at_price != null && product.compare_at_price > product.min_price;

// Máximo 2 insignias, por prioridad: Agotado, Más vendido, Nuevo.
const badges = [
  !product.in_stock && { label: "Agotado", className: "badge badge--muted" },
  product.is_bestseller && { label: "Más vendido", className: "badge badge--solid" },
  product.is_new && { label: "Nuevo", className: "badge" },
]
  .filter((b): b is { label: string; className: string } => Boolean(b))
  .slice(0, 2);
---

<article class="product-card">
  <a class="product-card__link" href={`/productos/${product.slug}`}>
    <div class="product-card__media">
      {
        product.image_url ? (
          <img
            src={product.image_url}
            alt={product.image_alt ?? product.name}
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="product-card__placeholder" aria-hidden="true" />
        )
      }
      {
        badges.length > 0 && (
          <ul class="product-card__badges">
            {badges.map((b) => (
              <li class={b.className}>{b.label}</li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="product-card__body">
      {categoryName && <p class="product-card__category">{categoryName}</p>}
      <Heading class="product-card__name">{product.name}</Heading>
      <p class="product-card__price">
        {
          onSale ? (
            <>
              <span class="visually-hidden">Precio rebajado:</span>
              <span class="price price--sale">{formatPrice(product.min_price)}</span>
              <span class="visually-hidden">, antes</span>
              <s class="price price--compare">{formatPrice(product.compare_at_price!)}</s>
            </>
          ) : (
            <span class="price">{formatPrice(product.min_price)}</span>
          )
        }
      </p>
    </div>
  </a>
</article>

<style>
  .product-card__link {
    display: grid;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }
  .product-card__link:hover .product-card__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .product-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--color-surface-tint);
  }
  .product-card__media img,
  .product-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__badges {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }
  /* Sobre la foto, las insignias claras necesitan contraste con el fondo salvia */
  .product-card__badges .badge:not(.badge--solid) {
    background: var(--color-surface);
    border: var(--border);
  }
  .product-card__body {
    display: grid;
    gap: var(--space-1);
  }
  .product-card__category {
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
  }
  .product-card__name {
    font-size: var(--text-card);
    line-height: var(--leading-h3);
  }
  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }
</style>
