---
/**
 * Tarjeta del formulario de solicitudes (contacto y eventos y mayoreo).
 *
 * Envía a POST /api/solicitudes (lo construye el rol Backend). Los nombres de
 * los campos siguen las columnas de la tabla `inquiries`; ver docs/RUTAS.md.
 * Con JavaScript, src/scripts/inquiry-form.ts valida, muestra el estado de
 * envío y los avisos; sin JavaScript el envío es un POST normal.
 */
import { site, whatsappUrl } from "../config/site";

interface Props {
  /** Formulario de origen; viaja como campo oculto `form`. */
  form: "contacto" | "eventos";
  /** Nombre accesible del formulario (título oculto a la vista). */
  title: string;
  submitLabel: string;
  /** Mensaje que se muestra cuando el envío se guarda bien. */
  successMessage: string;
}

const { form, title, submitLabel, successMessage } = Astro.props;
const titleId = `${form}-form-title`;
const whatsapp = whatsappUrl();
const email = site.email;
---

<div class="inquiry">
  <form
    class="inquiry__form"
    action="/api/solicitudes"
    method="post"
    aria-labelledby={titleId}
    data-inquiry-form
  >
    <h2 id={titleId} class="visually-hidden">{title}</h2>
    <input type="hidden" name="form" value={form} />

    <div class="inquiry__fields">
      <slot />
    </div>

    {/* Trampa contra spam: una persona no la ve ni llega con el teclado. Si trae texto, Backend descarta el envío. */}
    <div class="visually-hidden" aria-hidden="true">
      <label for={`${form}-website`}>No llenes este campo</label>
      <input id={`${form}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="inquiry__footer">
      <button class="btn btn--primary" type="submit" data-submit data-label={submitLabel}>
        {submitLabel}
      </button>
      <p class="inquiry__note"><slot name="note" /></p>
    </div>

    {/* Avisos: el script muestra uno a la vez y le pasa el foco. */}
    <div class="inquiry__notices" role="status">
      <div class="notice notice--success" data-notice="success" tabindex="-1" hidden>
        <p>{successMessage}</p>
      </div>
      <div class="notice" data-notice="unavailable" tabindex="-1" hidden>
        <p>El envío en línea aún no está disponible. Tus datos siguen en el formulario.</p>
        {
          (whatsapp || email) && (
            <p>
              Mientras tanto, escríbenos
              {whatsapp && (
                <>
                  {" "}
                  <a href={whatsapp} rel="noopener">
                    por WhatsApp
                  </a>
                </>
              )}
              {whatsapp && email && " o"}
              {email && (
                <>
                  {" "}
                  a <a href={`mailto:${email}`}>{email}</a>
                </>
              )}
              .
            </p>
          )
        }
      </div>
      <div class="notice notice--error" data-notice="error" tabindex="-1" hidden>
        <p>No pudimos enviar tu mensaje. Inténtalo de nuevo en unos minutos; tus datos siguen en el formulario.</p>
      </div>
    </div>
  </form>
</div>

<script>
  import { enhanceInquiryForms } from "../scripts/inquiry-form";
  enhanceInquiryForms();
</script>

<style>
  .inquiry {
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }
  @media (min-width: 768px) {
    .inquiry {
      padding: var(--space-7) var(--space-6);
    }
  }
  .inquiry__form {
    display: grid;
    gap: var(--space-5);
  }

  /* Rejilla de campos: una columna; en tableta y más, los campos con .field--half van de dos en dos. */
  .inquiry__fields {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 640px) {
    .inquiry__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
    .inquiry__fields > :global(*) {
      grid-column: 1 / -1;
    }
    .inquiry__fields > :global(.field--half) {
      grid-column: auto;
    }
  }

  .inquiry__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }
  .inquiry__note {
    flex: 1 1 16rem;
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    color: var(--color-text-secondary);
  }
  .inquiry__note:empty {
    display: none;
  }
  /* Mientras se envía: "Enviando…" legible (sin la opacidad de deshabilitado) y cursor de espera. */
  [data-submit][aria-disabled="true"] {
    opacity: 1;
    cursor: progress;
  }

  /* ---------- Avisos ---------- */
  .notice {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    color: var(--color-text);
  }
  .notice--success {
    border-left-color: var(--success-700);
  }
  .notice--error {
    border-left-color: var(--error-700);
  }
  .notice a {
    color: var(--color-primary);
  }
</style>
