---
import Logo from "./Logo.astro";

const shop = [
  { href: "/categoria/velas", label: "Velas" },
  { href: "/categoria/belleza", label: "Belleza" },
  { href: "/categoria/insumos", label: "Insumos" },
  { href: "/categoria/moldes-3d", label: "Moldes 3D" },
];
const help = [
  { href: "/envios", label: "Envíos" },
  { href: "/contacto", label: "Contacto" },
  { href: "/privacidad", label: "Aviso de privacidad" },
  { href: "/terminos", label: "Términos y condiciones" },
];
---

<footer class="site-footer section--alt">
  <div class="container site-footer__inner">
    <div class="stack site-footer__brand">
      <Logo />
      <p class="small muted">Velas artesanales e insumos para crearlas, hechos en pequeños lotes.</p>
    </div>
    <nav class="site-footer__col" aria-labelledby="footer-tienda">
      <h2 id="footer-tienda" class="site-footer__title">Tienda</h2>
      <ul>{shop.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav class="site-footer__col" aria-labelledby="footer-ayuda">
      <h2 id="footer-ayuda" class="site-footer__title">Ayuda</h2>
      <ul>{help.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border);
    padding-block: var(--space-8);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .site-footer__brand {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: auto;
    }
  }
  /* h2 por jerarquía, con tamaño de interfaz (DM Sans) */
  .site-footer__title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-body);
    line-height: var(--leading-ui);
    margin-bottom: var(--space-3);
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .site-footer ul a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .site-footer ul a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
