---
// Imagotipo horizontal (docs/identidad-marca.png): isotipo + "VELAS / STARLIGHT".
---

<a class="logo" href="/">
  <img src="/logo/isotipo.svg" alt="" width="40" height="40" />
  <span class="logo__text">
    <span class="visually-hidden">Velas Starlight, inicio</span>
    <span class="logo__top" aria-hidden="true">Velas</span>
    <span class="logo__main" aria-hidden="true">Starlight</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-primary);
    text-decoration: none;
  }
  .logo img {
    width: var(--space-6);
    height: auto;
  }
  .logo__text {
    display: grid;
    line-height: var(--leading-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-logo);
  }
  .logo__top {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }
  .logo__main {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }
</style>
